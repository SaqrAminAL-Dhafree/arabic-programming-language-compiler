<Window x:Class="ArabicCompiler.UI.SymbolTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Symbol Table" Height="400" Width="600">
    <Grid Margin="8">
        <DataGrid Name="SymbolsGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160"/>
                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>