<Window x:Class="ArabicCompiler.UI.TokensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tokens Viewer" Height="400" Width="600">
    <Grid Margin="8">
        <DataGrid Name="TokensGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding TokenType}" Width="120"/>
                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="60"/>
                <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
