// برنامج اختبار للطباعة المتعددة، العمليات، الحلقات، الشروط، والنصوص

برنامج طباعة_متعدد؛

متغير
    س، ص، مجموع، عد: صحيح؛
    رسالة: خيط_رمزي؛

{
    // حسابات
    س = 7؛
    ص = 8؛
    مجموع = س + ص * 2؛
    رسالة = "الناتج:"؛

    // طباعة متعددة: رسالة، مجموع، رقم ثابت
    اطبع(رسالة، مجموع، 100)؛

    // شرط
    اذا ( س < ص ) فان { اطبع("س أصغر من ص"، س) } والا { اطبع("س ليس أصغر من ص") }؛

    // حلقة while
    عد = 0؛
    طالما ( عد < 3 ) استمر {
    اطبع("حلقة عد ="، عد)؛
        عد = عد + 1؛
    }؛

    // repeat-until
    عد = 0؛
    اعد { اطبع("كرر:"، عد)؛ عد = عد + 1؛ } حتى ( عد == 2 )؛

    // طباعة نهائية متعددة مع نصوص وأرقام
    اطبع("انتهى الاختبار."، "المجموع النهائي:"، مجموع)؛

}.

