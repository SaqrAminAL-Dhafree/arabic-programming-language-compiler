برنامج مثال_حساب؛

متغير
    أ، ب، ناتج: صحيح؛

{
    أ = 10؛
    ب = 3؛
    ناتج = أ + ب؛
    اطبع("جمع:", ناتج)؛

    ناتج = أ - ب؛
    اطبع("طرح:", ناتج)؛

    ناتج = أ * ب؛
    اطبع("ضرب:", ناتج)؛

    ناتج = أ / ب؛
    اطبع("قسمة (تقريبية صحيحة):", ناتج)؛

    ناتج = أ % ب؛
    اطبع("باقي:", ناتج)؛
}.
