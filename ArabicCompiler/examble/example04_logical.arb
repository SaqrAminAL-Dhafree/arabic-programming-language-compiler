برنامج مثال_منطقيات؛

متغير
    ع، ب، نتيجة: صحيح؛

{
    // ملاحظة: اللغة تفترض تمثيل القيم المنطقية كأعداد (0/1) في هذا المشروع
    ع = 1; // true
    ب = 0; // false

    نتيجة = ع && ب؛ // او رمز منطقي يعتمد على القواعد؛ إذا لم توفر القواعد استبدل بما يناسب
    اطبع("AND (ع && ب) =", نتيجة)؛

    نتيجة = ع || ب؛
    اطبع("OR (ع || ب) =", نتيجة)؛

    // Not: تحويل مثال بسيط
    اذا ( ع == 1 ) فان { اطبع("ع صحيح") } والا { اطبع("ع خطأ") }؛
}.
