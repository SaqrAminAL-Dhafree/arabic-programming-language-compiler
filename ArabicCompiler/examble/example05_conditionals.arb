برنامج مثال_شروط؛

متغير
    س، ص: صحيح؛

{
    س = 7؛
    ص = 10؛

    اذا ( س < ص ) فان {
        اطبع("س أصغر من ص", س, ص)؛
    } الا {
        اطبع("س ليس أصغر من ص")؛
    }؛

    // شرط متداخل
    اذا ( س == 7 ) فان {
        اذا ( ص == 10 ) فان { اطبع("الزوج المتوقع") } الا { اطبع("زوج غير متوقع") }؛
    } الا { اطبع("س ليس 7") }؛
}.
