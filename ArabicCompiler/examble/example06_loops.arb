برنامج مثال_حلقات؛

متغير
    عد: صحيح؛

{
    // while
    عد = 0؛
    طالما ( عد < 3 ) استمر {
        اطبع("while عد =", عد)؛
        عد = عد + 1؛
    }؛

    // repeat-until
    عد = 0؛
    اعد {
        اطبع("repeat عد =", عد)؛
        عد = عد + 1;
    } حتى ( عد == 2 )؛

    // for-like (باستخدام while) مثال: عد من 1 إلى 5
    عد = 1؛
    طالما ( عد <= 5 ) استمر {
        اطبع("for-like عد =", عد)؛
        عد = عد + 1؛
    }؛
}.
