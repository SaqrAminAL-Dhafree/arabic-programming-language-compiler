برنامج المثال_النهائي؛

// مثال نهائي يجمع كل الميزات: تعريفات، إجراءات، طباعة، شروط، حلقات، تعيين.

متغير
    س، ص، مجموع، عد: صحيح؛
    رسالة: خيط_رمزي؛

{   
    // تعريف بسيط
    س = 20؛
    ص = 23؛
    مجموع = س + ص؛
    اطبع("المجموع في Main:", مجموع)؛

    // إجراء بسيط
    اجراء اعرض_مجموع() {
        اطبع("استدعاء الإجراء — مجموع:", مجموع)؛
    };

    // استدعاء الإجراء
    اعرض_مجموع();

    // شرط
    اذا (مجموع < 50) فان {
        اطبع("المجموع أقل من 50")
    } الا {
        اطبع("المجموع 50 أو أكثر")
    };

    // حلقة
    عد = 0؛
    طالما (عد < 2) استمر {
        اطبع("التكرار:", عد);
        عد = عد + 1;
    };

    // طباعة خيط
    رسالة = "انتهى الاختبار";
    اطبع(رسالة)؛
}.
